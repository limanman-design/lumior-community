{
  "name": "lumior-desktop",
  "productName": "Lumior Community",
  "version": "0.1.35",
  "description": "Lumior local research workspace",
  "author": "Lumior",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/community-pack.mjs --dir",
    "dist:mac": "node scripts/community-pack.mjs --platform mac",
    "dist:win": "node scripts/community-pack.mjs --platform win",
    "dist:win:update": "node scripts/windows-preview.mjs --updates",
    "release:check": "node scripts/release.mjs --preflight --platform mac",
    "release:mac": "node scripts/release.mjs --platform mac",
    "build:official": "node scripts/build.mjs --official",
    "dist:win:preview": "node scripts/windows-preview.mjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "app.lumior.community",
    "productName": "Lumior Community",
    "asar": true,
    "electronLanguages": [
      "en",
      "en-GB",
      "zh-CN",
      "zh-TW"
    ],
    "directories": {
      "output": "../output/desktop-builds.noindex",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "pet-preload.cjs",
      "pet/**/*",
      "runtime/desktop-pet.cjs",
      "runtime/pet-store.cjs",
      "runtime/pet-options.json",
      "assets/ui-colors.css",
      "wallpaper-preload.cjs",
      "runtime/star-wallpaper.cjs",
      "runtime/app-identity.cjs",
      "runtime/distribution.cjs",
      "runtime/window-preferences.cjs",
      "runtime/window-appearance.cjs",
      "runtime/clipboard-images.cjs",
      "runtime/ai-settings.cjs",
      "runtime/backend.mjs",
      "runtime/network.cjs",
      "runtime/credentials.cjs",
      "runtime/security.cjs",
      "runtime/trial-access.cjs",
      "runtime/update-build.cjs",
      "runtime/updates.cjs",
      "assets/icon.png",
      "assets/icon-windows.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "generated",
        "to": "lumior-runtime",
        "filter": [
          "**/*",
          "!verification.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "electronLanguages": [
        "en",
        "en_GB",
        "zh_CN",
        "zh_TW"
      ],
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon-windows.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Lumior-Community-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "lumiorDistribution": "community",
  "lumiorChannel": "community"
}
