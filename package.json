{
  "name": "lumior-community",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:public": "node scripts/test-public.mjs",
    "design:scan": "node scripts/audit-design-system.mjs",
    "design:dev": "node scripts/design-system.mjs",
    "design:build": "node scripts/design-system.mjs --build",
    "colors:sync": "node scripts/sync-ui-colors.mjs",
    "colors:check": "node scripts/sync-ui-colors.mjs --check && node scripts/check-ui-colors.mjs",
    "dev": "node scripts/dev-with-pdf-layout.mjs",
    "dev:layout": ".venv-pdf-layout/bin/python scripts/pdf-layout-service.py --python .venv-pdf-layout/bin/python --cache .cache-pdf-layout --work-root output/pdf/layout-jobs",
    "build": "node scripts/sync-ui-colors.mjs --check && node scripts/check-ui-colors.mjs && node scripts/sync-mba-skills.mjs && vinext build",
    "start": "node server.mjs",
    "start:worker": "wrangler dev --config dist/server/wrangler.json",
    "desktop:build": "pnpm --dir desktop build",
    "desktop:start": "pnpm --dir desktop start",
    "desktop:dev": "pnpm --dir desktop dev",
    "desktop:mac": "pnpm --dir desktop dist:mac",
    "desktop:win": "pnpm --dir desktop dist:win",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@blocknote/core": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@blocknote/shadcn": "^0.54.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.15",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "mammoth": "^1.12.2",
    "mermaid": "11.15.0",
    "motion": "14.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "license": "Apache-2.0"
}
